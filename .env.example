# Скопируйте в .env и заполните SECRET_KEY перед запуском
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,dev.nightwell.fun
DJANGO_CSRF_TRUSTED_ORIGINS=https://dev.nightwell.fun
DJANGO_SECURE_SSL_REDIRECT=false
# Включать только за доверенным reverse proxy, который перезаписывает этот заголовок
DJANGO_TRUST_PROXY_SSL_HEADER=false

# Для локальной разработки оставить пустым (SQLite)
DATABASE_URL=
# Для сервера: postgresql://username:password@127.0.0.1:5432/nightwell_dev

# Необязательно: файловый путь вне публичной директории веб-сервера
PRIVATE_UPLOAD_ROOT=
